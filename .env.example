# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# KONFIGURASI DATABASE POSTGRESQL (Cloud SQL & Custom PostgreSQL / Supabase)
# ============================================================================
# Jika ingin memakai Supabase / Neon / PostgreSQL eksternal, isi DATABASE_URL di panel Secrets
# (Contoh: postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres)
DATABASE_URL=""

# Cloud SQL Runtime Environment Variables (injected automatically by platform — jangan diubah di .env.example)
# Catatan: Jika dijalankan di VS Code lokal, salin file ini menjadi .env lalu ubah SQL_HOST="localhost" di file .env
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"


